        def PhysicsPrismaticJoint "joint8" (
            prepend apiSchemas = ["PhysicsJointStateAPI:linear", "PhysxJointAPI", "PhysicsDriveAPI:linear", "PhysicsMimicAPI"]
        )
        {
            string physics:mimic:joint = "/piper/joint7"  # joint being mimicked
            float physics:mimic:offset = 0                # offset (none)
            float physics:mimic:scale = -1                 # scale factor -1 reverses the motion direction

            float drive:linear:physics:damping = 0
