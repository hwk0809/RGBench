            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 10000000
            float drive:angular:physics:targetPosition = 0
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            rel physics:body0 = </piper/dummy_link>
            rel physics:body1 = </piper/link1>
            float physics:breakForce = 3.4028235e38
            float physics:breakTorque = 3.4028235e38
            float physics:JointEquivalentInertia = 0.012992468
            point3f physics:localPos0 = (0, 0, 0.123)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -150.00035
            float physics:upperLimit = 124.21724
            float physxJoint:maxJointVelocity = 286.47888
        }

